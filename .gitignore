/target
Cargo.lock

# Local secrets (never commit)
.env
.env.local
.env.*.local

# Machine-local Cargo overrides (e.g. Windows target-dir paths) — never commit.
.cargo/

# Test data may contain confidential or licensed PSS/E case files — never commit them.
tests/data/external/

# Golden output RPF files are regenerated by `cargo test` — no need to track them.
tests/golden/*.rpf

# Belt-and-suspenders: block ALL power-system vendor data formats from ever being committed.
# Open-source IEEE/ACTIVSg inputs live only in tests/data/external/ (already ignored above).
*.raw
*.RAW
*.dyr
*.DYR
*.sav
*.SAV
*.epc
*.EPC
*.pss
*.PSS
*.pdf

# Internal private marketing guidance file (must never be committed).
INTERNAL-MARKETING-GUIDE.md
INTERNAL-PSSE-RPF-ROADMAP.md

# Cursor AI project rules — internal agent guidance; not committed on public repo.
.cursor/rules/

# Regression reports generated by the golden-suite; don't commit.
tests/golden/regression_golden_report.csv
tests/golden/regression_golden_report.txt

# Local RPF-quality iterate loop artifacts (regenerated RPFs, harness logs,
# delta report). The script tree (run.ps1 / parse_log.py / README.md /
# .gitignore) is committed via `!` rules in scripts/local_iterate/.gitignore.
scripts/local_iterate/out/
